# Cookidoo Credentials
COOKIDOO_EMAIL=your-email@example.com
COOKIDOO_PASSWORD=your-password-here

# Localization (default: es-ES)
# Options: es-ES, fr-FR, en-GB, de-DE, it-IT, pt-PT, nl-NL, etc.
COOKIDOO_COUNTRY=es
COOKIDOO_LANGUAGE=es-ES

# Device compatibility (default: TM6)
# Options: TM5, TM6, TM7, TM31
COOKIDOO_DEVICE=TM6

# Planning collections — colecciones de Cookidoo que se usan para planificación semanal
# Solo las recetas "aprobadas" que ya sabes que gustan a la familia.
# Separadas por coma. Si no se define, sync_library pedirá al usuario que elija.
COOKIDOO_PLANNING_COLLECTIONS=Las probe y me gustaron
